# Deepfake Detection Platform - Environment Configuration

# Application
APP_ENV=development
APP_NAME="Deepfake Detection Platform"
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-secure-random-key-32-chars-min
API_V1_STR=/api/v1

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database
# For production PostgreSQL: postgresql://postgres:postgres@localhost:5432/deepfake_detection
# Default local SQLite fallback supported for zero-setup local dev/test:
DATABASE_URL=sqlite:///./deepfake_detection.db

# Task Queue (Redis + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# When CELERY_ALWAYS_EAGER=true, tasks execute synchronously or via FastAPI BackgroundTasks (ideal for standalone dev)
CELERY_ALWAYS_EAGER=true

# Storage & File Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
MAX_VIDEO_DURATION_SECONDS=120  # 2 minutes
MAX_AUDIO_DURATION_SECONDS=300  # 5 minutes
MAX_VIDEO_FRAMES_SAMPLE=32
RETENTION_DAYS=7

# AI / ML Inference Configuration
ML_DEVICE=auto  # "auto", "cuda", or "cpu"
ML_BATCH_SIZE=8
ML_CHECKPOINTS_DIR=./ml/checkpoints
FACE_DETECTION_CONFIDENCE=0.85
VISUAL_MODEL_NAME=efficientnet_b0
AUDIO_MODEL_NAME=spectral_cnn
